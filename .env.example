# ======================================================================
#  SpeakUp — muhit o'zgaruvchilari namunasi
#  Haqiqiy qiymatlar serverdagi /root/speakup/.env da. Bu fayl faqat
#  qanday kalitlar kerakligini ko'rsatadi — hech qachon sir yozilmaydi.
# ======================================================================

# --- Dastur ---
APP_ENV=production
DEBUG=false
PORT=8082
APP_SECRET_KEY=
UPLOAD_DIR=/data/uploads

# --- Ma'lumotlar bazasi ---
# POSTGRES_PASSWORD docker-compose.yml tomonidan ham o'qiladi —
# DATABASE_URL ichidagi parol bilan AYNAN BIR XIL bo'lishi shart.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://speakup:PAROL@postgres:5432/speakup_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
REDIS_URL=redis://redis:6379/0

# --- Shifrlash / JWT ---
ENCRYPTION_MASTER_KEY=
BACKUP_ENCRYPTION_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

# --- Telegram bot ---
BOT_TOKEN=
BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_URL=
MINI_APP_URL=
ADMIN_ALERT_CHAT_IDS=
REQUIRED_CHANNEL=
CHANNEL_GATE_ENABLED=true

# --- AI (Groq) ---
GROQ_API_KEY=
GROQ_LLM_API_KEY=
GROQ_LLM_MODEL=
GROQ_WHISPER_MODEL=

# --- To'lov: Payme ---
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_TEST_SECRET_KEY=
PAYME_IS_TEST=false

# --- To'lov: Click ---
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# --- Tarif ---
PREMIUM_PRICE_UZS=
PREMIUM_PRICE_TIYIN=
FREE_DAILY_LIMIT_MINUTES=

# --- WebRTC / TURN ---
TURN_HOST=
TURN_STATIC_AUTH_SECRET=

# --- CORS ---
ALLOWED_ORIGINS=

# --- Talaffuz sidecar ---
# Faqat Docker ichki tarmog'i. Bo'sh qoldirilsa funksiya o'chadi (dev uchun).
TALAFFUZ_URL=http://talaffuz:7880
